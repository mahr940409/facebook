<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Facebook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Facebbok">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <nav class="navbar navbar-dark bg-primary shadow-sm mb-4">
      <div class="container-fluid px-4">
        <%= link_to "Facebook", root_path, class: "navbar-brand mb-0 h1 fw-bold fs-3 text-decoration-none" %>
        <% if current_user.present? %>
          <div class="d-flex align-items-center gap-2">
            <% if current_user.avatar.attached? %>
              <%= image_tag current_user.avatar, class: "rounded-circle object-fit-cover", width: 32, height: 32, alt: "Avatar" %>
            <% else %>
              <span class="fs-5 text-white">👤</span>
            <% end %>
    
            <%= link_to current_user.email, users_me_path, class: "navbar-brand mb-0 h1 fw-bold fs-5 text-white text-decoration-none" %>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="fs-5 text-white">💬</span>
            <%= link_to "Mensajes", groupchats_path, class: "nav-link text-white m-0" %>            
          </div>
          <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete, class: "btn btn-danger" %>
        <% end %>
      </div>
    </nav>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if flash.any? %>
      <div id="flash-messages">
        <% flash.each do |type, message| %>
          <div class="flash-message <%= type %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
