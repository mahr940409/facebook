<div class="container py-4">
  <div class="row g-4 align-items-start">

    <div class="col-md-3">
      <div class="card border-0 shadow-sm text-center">
        <div class="card-body p-4">
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar,
                class: "rounded-circle object-fit-cover mb-3",
                style: "width: 100px; height: 100px;",
                alt: "Foto de perfil" %>
          <% else %>
            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width: 100px; height: 100px;">
              <span class="text-muted small">Sin foto</span>
            </div>
          <% end %>

          <h4 class="h5 mb-0">
            Hola, <%= current_user.name.presence || current_user.email %>
          </h4>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <h3 class="h5 mb-3">Crear publicación</h3>
      <%= render "posts/form", post: @post %>

      <hr class="my-4">

      <h3 class="h5 mb-3">Publicaciones</h3>
      <%= render "posts/posts", posts: @posts %>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h4 class="h6 mb-3">Tus amigos</h4>
          <%= link_to "Ver mis amigos",
              me_friends_path,
              class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>

  </div>
</div>