<div class="container">
  <div class="row align-items-start">
    
    <div class="col-md-3">
        <h4>
            Hola:<%=current_user.name%>
        </h4>
    </div>

    <div class="col-md-6">
      <h3>Crear Post</h3>
      <%= render "posts/form", post: @post %>
      <hr>
      <%= render "posts/posts" %>
    </div>

    <div class="col-md-3">
      <h4>Quieres ver tus amigos</h4>
        <%= link_to "Ver mis amigos", friends_path(user_id: current_user.id), class: "btn btn-primary" %>
    </div>

  </div>
</div>
 