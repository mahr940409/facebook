<div class="container">
  <div class="row align-items-start">
    
    <div class="col-md-3">
      <h4>
          Hola:<%=current_user.name || current_user.email%>
      </h4>
      <div>
        <%if current_user.avatar.attached?%>
            <%= image_tag current_user.avatar, class: "rounded circle", style: "width: 100px; height: 100px"%>
          <%else%>
            <h5>No hay foto de perfil</h5>
          <%end%>    
      </div>
    </div>

    <div class="col-md-6">
      <h3>Crear Post</h3>
      <%= render "posts/form", post: @post %>
      <hr>
      <%= render "posts/posts", posts: @posts %>
    </div>

    <div class="col-md-3">
      <h4>Quieres ver tus amigos</h4>
        <%= link_to "Ver mis amigos", friends_path(user_id: current_user), class: "btn btn-primary" %>
    </div>

  </div>
</div>
 