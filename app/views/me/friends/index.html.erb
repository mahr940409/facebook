<div class="search container py-4">
  <%= form_with url: me_friends_path, method: :get, local: true do |form| %>
    <div class="input-group">
      <%= form.text_field :query,
          value: params[:query],
          placeholder: "Buscar por correo...",
          class: "form-control" %>

      <%= form.submit "Buscar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<div class="list container pb-4">
  <div class="d-flex flex-column gap-3">
    <% @users.each do |user| %>
      <div class="card border-0 shadow-sm">
        <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
          <span class="text-break"><%= user.email %></span>

          <%= button_to "Añadir amigo",
              friends_path(id: user.id),
              method: :post,
              class: "btn btn-success btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% @friends_status_requested.each do |request| %>
  <% if request.request_id == current_user.id %>
    <div class="container">
      <h2 class="h4 mb-3">Mis solicitudes</h2>
      <%= render "me/friends/request_friends",
          requests: @friends_status_requested %>
    </div>
  <% end %>
<% end %>

<div class="container py-4">
  <h2 class="h4 mb-3">Mis amigos</h2>
  <%= render "me/friends/friend_status_friends",
      comun_friends: @friends %>
</div>