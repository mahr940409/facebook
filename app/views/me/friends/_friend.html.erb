<div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
  <% if friend.sent == current_user %>
    <span class="fw-semibold text-break"><%= friend.request.email %></span>

    <%= link_to "Ver perfil",
        friend_path(id: friend.request.id),
        class: "btn btn-outline-primary btn-sm" %>
  <% else %>
    <span class="fw-semibold text-break"><%= friend.sent.email %></span>

    <%= link_to "Ver perfil",
        friend_path(id: friend.sent.id),
        class: "btn btn-outline-primary btn-sm" %>
  <% end %>
</div>