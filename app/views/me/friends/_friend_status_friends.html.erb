<div class="d-flex flex-column gap-3">
  <% comun_friends.each do |comun_friend| %>
    <div class="card border-0 shadow-sm">
      <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center gap-3">
        <div class="flex-shrink-0">
          <%= render partial: "me/friends/display_user_avatar",
              locals: { user: comun_friend } %>
        </div>

        <div class="flex-grow-1">
          <%= render partial: "me/friends/friend",
              locals: { friend: comun_friend } %>
        </div>

        <%= button_to "Eliminar amigo",
            friend_path(id: comun_friend.id),
            method: :delete,
            class: "btn btn-outline-danger btn-sm flex-shrink-0" %>
      </div>
    </div>
  <% end %>
</div>