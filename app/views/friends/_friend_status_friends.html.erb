<h4>My Friends</h4>

  <%comun_friends.each do |comun_friend|%>
    <%= render partial: "display_user_avatar", locals: {user: comun_friend} %>
    <%= render partial: "friend", locals: {friend: comun_friend} %>

    <%if comun_friend.mutual == true%>
      <h4>amigo en comun</h4>
    <%else%>
      <%if @user == current_user%>
        <%= button_to "Eliminar amigo", friend_path(id: comun_friend.id), method: :delete, class:"btn btn-danger"%>
      <%else%>
        <%= button_to "Añadir amigo", friends_path(id: comun_friend.id), method: :post, class:"btn btn-success"%>
      <%end%>  
    <%end%>
    
  <%end%>
</div>