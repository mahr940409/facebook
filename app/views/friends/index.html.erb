<%= link_to "Home", root_path%>

<div class="search container">
  <%= form_with url: friends_path, method: :get, local: true do |form|%>
    <%= form.text_field :query, 
                          value: params[:query], 
                          placeholder: "Buscar...", 
                          class: "search-input" %>
    <%= form.submit "Search", class: "search-button"%>
  <%end%>
</div>

<div class="list container">
  <%@users.each do |user|%>
    <%=user.email%>
    <%= button_to "Añadir amigo", friends_path(id: user.id), method: :post%>
    <%end%>
</div>


<h2>My Requests and My Friends</h2>
<h4>My email <%= current_user.email %></h4>

<% @friends.each do |friend| %>
  <%if friend.status == "requested" && friend.sent_id != current_user.id%>
  <h4> solicitud recibida de 
    <%= display_corrent_user_name(friend, current_user).email %>
  </h4>
  <%= button_to "Aceptar", friend_path(id: friend), method: :put %>
  <%= button_to "Rechazar", friend_path(id: friend), method: :delete %>
  <%elsif friend.status == "friends"%>
    <h4>friend email <%= display_corrent_user_name(friend, current_user).email %></h4>
    <%= button_to "Eliminar Amigo", friend_path(friend), method: :delete%>
  <%end%>
<% end %>
    