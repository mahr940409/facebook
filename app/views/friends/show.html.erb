<div class="container py-4">
  <div class="row g-4 align-items-start">

    <%= render "info_other_profile", user: @user %>

    <div class="col-md-6">
      <h3 class="h5 mb-3">Sus publicaciones</h3>
      <%= render "posts/posts", posts: @user.posts %>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h4 class="h6 mb-3">Amigos</h4>
          <%= link_to "Ver sus amigos",
              user_friends_path(user_id: @user.id),
              class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>

  </div>
</div>