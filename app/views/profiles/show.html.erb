<div class="container">
  <div class="row align-items-start">
    
    <div class="col-md-3">
      <h4>
          Perfil de:<%=@user.name%>
      </h4>
      <div>
        <%if @user.avatar.attached?%>
            <%= image_tag @user.avatar, class: "rounded circle", style: "width: 100px; height: 100px"%>
          <%else%>
            <h5>No hay foto de perfil</h5>
          <%end%>    
      </div>
    </div>

    <div class="col-md-6">
      
      <h3>Sus Post</h3>
            
      <%=render "posts/posts", posts: @user.posts%>
      
    </div>

    <div class="col-md-3">
      <h4>Quieres ver sus amigos</h4>
        <%= link_to "Ver sus amigos", user_friends_path(user_id: @user.id), class: "btn btn-primary" %>
    </div>

  </div>
</div>
 