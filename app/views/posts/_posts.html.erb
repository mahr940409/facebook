
<%posts.each do |post|%>
    <%if post.image.attached?%>
        <%=image_tag post.image, style: "width: 150px; height: 150px"%>
    <%end%>
    <p><%= post.text%></p>
    <%= post.created_at.strftime("%d/%m/%Y %H:%M") %>
    <p>Publicacion realizada por: <%= post.user.email%></p>
    <p><%= link_to "Ver o realizar un comentario", post_path(post), class:"btn btn-primary" %> </p>
    <hr>
<%end%>