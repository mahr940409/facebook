<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <%= form_with(model: post) do |form| %>
      <% if post.image.attached? %>
        <div class="mb-3">
          <p class="form-label fw-semibold">Imagen actual</p>

          <%= image_tag post.image,
              class: "img-thumbnail object-fit-cover d-block mb-2",
              style: "width: 100px; height: 100px;",
              alt: "Imagen de la publicación" %>

          <div class="form-check">
            <%= form.check_box :remove_image, class: "form-check-input" %>
            <%= form.label :remove_image,
                "Eliminar imagen actual",
                class: "form-check-label" %>
          </div>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :image, "Imagen", class: "form-label" %>
        <%= form.file_field :image, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :text, "Escribe tu post:", class: "form-label" %>
        <%= form.text_area :text,
            rows: 5,
            placeholder: "¡Comparte tus pensamientos aquí!",
            class: "form-control" %>
      </div>

      <div class="d-flex justify-content-end">
        <%= form.submit(
          post.persisted? ? "Editar" : "Publicar",
          class: post.persisted? ? "btn btn-success" : "btn btn-primary"
        ) %>
      </div>
    <% end %>
  </div>
</div>