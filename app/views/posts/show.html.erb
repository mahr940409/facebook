
<div class="container d-flex flex-column gap-2">
	<h2 class="mb-0">POST:</h2>
	<h3 class="mb-0"><%=@post.text%></h3>
</div>
 
<div class="container">
 
	<div class="d-flex gap-2 justify-content-center py-5">
		<h5> Likes <%=@count%></h5>
		<%if @like.present?%>	
		<%= button_to "dislike", post_like_path(post_id: @post.id, id: @like.id), method: :delete, class:"btn btn-danger" %>
	<%else%>	
		<%= button_to "like", post_likes_path(post_id: @post.id), method: :post, class:"btn btn-success"%>
	<%end%>	



	<%if @post.user_id == current_user.id%>
		<%= form_with(url: post_path(@post.id) , method: :delete) do |form| %>
			<div class="actions">
				<%= form.submit "Eliminar", class:"btn btn-danger"%>
			</div>
		<%end%>
		<%= form_with(url: edit_post_path(@post.id) , method: :get) do |form| %>
			<div class="actions">
				<%= form.submit "Editar", class:"btn btn-info" %>
			</div>
		<%end%>	
	<%end%>
	</div>
	
</div>

<hr>
	<%=render "comments/form", comment: @comment, post: @post%>
<hr>

<%= render "comments/comments", comments: @comments%>
