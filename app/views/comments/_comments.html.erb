<div class="container py-4">
  <h4 class="mb-4">Comentarios</h4>

  <% if comments.present? %>
    <div class="d-flex flex-column gap-3">
      <% comments.each do |comment| %>
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
              <strong><%= comment.user.email %></strong>
              <small class="text-muted text-nowrap">
                <%= comment.created_at.strftime("%d/%m/%Y %H:%M") %>
              </small>
            </div>

            <p class="card-text mb-3"><%= comment.text %></p>

            <% if comment.user_id == current_user.id %>
              <div class="d-flex gap-2">
                <%= button_to "Editar",
                    edit_post_comment_path(post_id: @post.id, id: comment.id),
                    method: :get,
                    class: "btn btn-outline-primary btn-sm" %>

                <%= button_to "Eliminar",
                    post_comment_path(post_id: @post.id, id: comment.id),
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center bg-light rounded p-4">
      <p class="text-muted mb-0">Aún no hay comentarios en esta publicación.</p>
    </div>
  <% end %>
</div>