<div class="container py-4">
  <div class="row g-4">

    <div class="col-md-6">
      <h4 class="h5 mb-3">Mis chats</h4>

      <div class="d-flex flex-column gap-3">
        <% @groupchats.each do |groupchat| %>
          <% other = groupchat.other_user(current_user) %>

          <div class="card border-0 shadow-sm">
            <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
              <span class="text-truncate">
                <strong>Chat con:</strong> <%= other.email %>
              </span>

              <%= link_to "Ver mensajes",
                  groupchat_path(id: groupchat.id),
                  class: "btn btn-outline-primary btn-sm flex-shrink-0" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-md-6">
      <h4 class="h5 mb-3">Tus amigos</h4>

      <div class="d-flex flex-column gap-3">
        <% @friends.each do |friend| %>
          <% display_corrent_user_name = display_corrent_user_name(friend, current_user) %>

          <div class="card border-0 shadow-sm">
            <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
              <div class="d-flex align-items-center gap-2 overflow-hidden">
                <% if display_corrent_user_name.avatar.attached? %>
                  <%= image_tag display_corrent_user_name.avatar,
                      class: "rounded-circle object-fit-cover flex-shrink-0",
                      style: "width: 40px; height: 40px;",
                      alt: "Foto de perfil" %>
                <% end %>

                <span class="text-truncate">
                  <%= display_corrent_user_name.email %>
                </span>
              </div>

              <%= link_to "Enviar mensaje",
                  new_groupchat_path(reciver: display_corrent_user_name, sender: current_user),
                  class: "btn btn-success btn-sm flex-shrink-0" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>