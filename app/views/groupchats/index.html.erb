<div class="container my-4">
  <div class="row">

   
    <div class="col-md-6 mb-4">
      <h4 class="mb-3">Mis Chats</h4>
      <% @groupchats.each do |groupchat| %>
        <% other = groupchat.other_user(current_user) %>
        
        <div class="card mb-2 p-3 d-flex flex-row justify-content-between align-items-center">
          <span class="text-truncate me-2"><strong>Chat con:</strong> <%= other.email %></span>
          <%= link_to "Ver mensajes", groupchat_path(id: groupchat.id), class: "btn btn-outline-primary btn-sm flex-shrink-0" %>
        </div>
      <% end %>
    </div>

    
    <div class="col-md-6">
      <h4 class="mb-3">Tus amigos son:</h4>
      <% @friends.each do |friend| %>
        <% display_corrent_user_name = display_corrent_user_name(friend, current_user) %>
        
        <div class="card mb-2 p-3 d-flex flex-row justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2 text-truncate me-2">
            <% if display_corrent_user_name.avatar.attached? %>
              <%= image_tag display_corrent_user_name.avatar, class: "rounded-circle flex-shrink-0", style: "width: 40px; height: 40px;" %>
            <% end %>
            <span class="text-truncate"><%= display_corrent_user_name.email %></span>
          </div>

          <%= link_to "Enviar Mensaje", new_groupchat_path(reciver: display_corrent_user_name, sender: current_user), class: "btn btn-success btn-sm flex-shrink-0" %>
        </div>
      <% end %>
    </div>

  </div>
</div>