<div class="container py-4">
  <div class="card border-0 shadow-sm mx-auto" style="max-width: 600px;">
    <div class="card-body p-4">
      <h2 class="h4 mb-4">
        Enviar nuevo mensaje a
        <span class="text-primary"><%= @reciver.name %></span>
      </h2>

      <%= form_with(url: groupchats_path(sender: @sender.id), method: :post, local: true) do |f| %>
        <%= f.hidden_field :reciver, value: @reciver.id %>

        <div class="mb-3">
          <%= f.label :text, "Mensaje", class: "form-label fw-semibold" %>
          <%= f.text_area :text,
              rows: 4,
              class: "form-control",
              placeholder: "Escribe tu mensaje aquí...",
              required: true %>
        </div>

        <div class="d-grid d-sm-flex justify-content-sm-end">
          <%= f.submit "Enviar mensaje", class: "btn btn-primary px-4" %>
        </div>
      <% end %>
    </div>
  </div>
</div>