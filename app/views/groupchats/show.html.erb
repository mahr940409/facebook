<div class="container my-4" style="max-width: 600px;">
  <div class="card shadow-sm">
    
    
    <div class="card-header bg-primary text-white p-3">
      <h5 class="mb-0">Chat con: <%= @sender.email %></h5>
    </div>

    
    <div class="card-body p-3" style="max-height: 400px; overflow-y: auto;">
      <% @messages.each do |message| %>
        <% mine = message.user == current_user %>
        
        <div class="d-flex flex-column <%= mine ? 'align-items-end' : 'align-items-start' %> mb-3">
          <small class="text-muted mb-1"><%= message.user.email %></small>
          <div class="p-2 px-3 rounded-3 <%= mine ? 'bg-primary text-white' : 'bg-light text-dark border' %>" style="max-width: 80%;">
            <p class="mb-0"><%= message.text %></p>
          </div>
        </div>
      <% end %>
    </div>

    
    <div class="card-footer bg-white p-3 border-top">
      <%= form_with url: groupchat_messages_path(groupchat_id: @groupchat.id), method: :post do |form| %>
        <div class="mb-2">
          <%= form.label :text, "Escribe tu respuesta", class: "form-label fw-semibold" %>
          <%= form.text_area :text, rows: 2, placeholder: "¡responde aquí!", class: "form-control", required: true %>
        </div>
        <div class="d-flex justify-content-end">
          <%= form.submit "Responder", class: "btn btn-primary btn-sm px-3" %>
        </div>
      <% end %>
    </div>

  </div>
</div>